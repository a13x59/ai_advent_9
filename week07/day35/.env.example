# Порт, на котором приложение слушает снаружи (доступ http://VPS_IP:8080)
APP_PORT=8080

# Внутренний адрес Python-воркера (внутри docker-compose менять не нужно)
WORKER_URL=http://worker:8000

# DeepSeek (ключ заполняете сами; deploy.sh его НЕ запрашивает)
DEEPSEEK_API_KEY=
DEEPSEEK_MODEL=deepseek-chat
ENABLE_LLM_GATE=true

# Путь к ffmpeg внутри контейнера приложения
FFMPEG_PATH=ffmpeg
