# Приватный AI-сервис на VPS (CPU-only, 2 ГБ RAM).
# deploy.sh копирует этот файл в корень проекта (.env) при первом запуске.

# --- Ollama (loopback, наружу НЕ открывается) ---
OLLAMA_BASE_URL=http://127.0.0.1:11434
# Компактная модель под 2 ГБ RAM. Фолбэки: llama3.2:1b, qwen2.5:0.5b.
OLLAMA_MODEL=qwen2.5:1.5b
# Контекстное окно: держим небольшим, иначе KV-кэш съест память.
OLLAMA_NUM_CTX=2048
OLLAMA_TIMEOUT=300
# Ограничение одновременных вызовов модели (semaphore на стороне агента).
OLLAMA_MAX_CONCURRENCY=2
OLLAMA_CONCURRENCY_TIMEOUT=600
# Ретраи на transient-ошибки Ollama.
OLLAMA_MAX_RETRIES=2
OLLAMA_RETRY_BACKOFF=2.0

# --- Лимиты агентского сервиса ---
# Rate limit per-IP (запросов/минуту), на уровне агента.
AGENT_RATE_LIMIT_PER_MINUTE=20
# Бюджет промпта в токенах (защита от переполнения контекста, <= num_ctx).
AGENT_MAX_PROMPT_TOKENS=1536

# --- Публичный API ---
# X-Api-Key, который проверяет nginx. Если пусто — deploy.sh сгенерирует сам.
AGENT_API_KEY=

# --- Опционально: RAG-сервис (включён, MCP на VPS не разворачиваем) ---
RAG_BASE_URL=http://127.0.0.1:8891
